---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="section" aria-label="Not found">
    <h2 class="section-title">404</h2>
    <div class="section-body">
      <p>The page you are looking for doesn&apos;t exist or may have been moved.</p>
      <p><a class="btn btn--primary" href="/">Back to home</a></p>
    </div>
  </section>
</BaseLayout>
