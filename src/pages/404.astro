---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for could not be found."
  noindex
>
  <section class="section" aria-label="Not found">
    <header class="page-heading">
      <span class="eyebrow">404 / Page not found</span><h1>A missing page.</h1>
      <p>The page you are looking for doesn’t exist or may have been moved.</p>
    </header>
    <p><a class="btn btn--primary" href="/">Back to home</a></p>
  </section>
</BaseLayout>
