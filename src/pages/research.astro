---
import BaseLayout from '../layouts/BaseLayout.astro';
import SequenceVisual from '../components/SequenceVisual.astro';
import { publications } from '../data/publications';
import { site } from '../data/site';
---

<BaseLayout
  title="Research"
  description="Language models, fungal genomes, and explainable machine learning. Research by Nikesh Gyawali at Kansas State University."
>
  <header class="page-heading">
    <span class="eyebrow">AI / LLMs / Computational biology</span><h1>
      Learning from language.<br />Understanding life.
    </h1><p>
      I study how models learn from sequences, from the opinions inside a
      sentence to the patterns inside a fungal genome.
    </p>
  </header>
  <div class="research-position">
    <span class="status">CURRENTLY</span><p>
      Postdoctoral Fellow, Department of Plant Pathology<br /><span
        >Kansas State University</span
      >
    </p>
  </div>
  <section class="research-area" id="foundation-models">
    <div class="area-heading">
      <span class="eyebrow">Foundation models</span><h2>
        What can DNA teach a language model?
      </h2>
    </div>
    <div class="fundlm-feature">
      <div>
        <span class="status">ONGOING</span><h3>FunDLM</h3><p>
          Foundation models for fungal genomes, built with large-scale sequence
          data and scalable training pipelines.
        </p><p>
          My current work explores pre-training language models with up to 1.3B
          parameters, with the aim of learning representations that support
          biological sequence analysis.
        </p><a class="btn" href="/projects/fundlm"
          >Motivation, approach & current work ↗</a
        >
      </div><SequenceVisual />
    </div>
  </section>
  <section class="research-area" id="language-models">
    <div class="area-heading">
      <span class="eyebrow">Large language models</span><h2>
        The opinions behind the words.
      </h2>
    </div><div class="research-prose">
      <p>
        My Ph.D. centered on stance detection: using language models and hybrid
        semi-supervised methods to identify opinions on socially and
        economically important topics.
      </p><p>
        The work spans gun control debates, vaccine discourse, SEC filings, and
        earnings call transcripts, with an emphasis on improving label quality
        and reducing reliance on manual annotation.
      </p><div class="link-row">
        <a class="btn" href="/projects/gunstance">GunStance ↗</a><a
          class="btn"
          href="https://arxiv.org/abs/2510.23464"
          target="_blank"
          rel="noopener noreferrer">Financial stance paper ↗</a
        ><a
          class="btn"
          href="https://github.com/gnikesh/llm-financial-stance"
          target="_blank"
          rel="noopener noreferrer">Financial stance code ↗</a
        ><a class="btn" href="/projects/vaccine-discourse"
          >Vaccine discourse & dataset ↗</a
        >
      </div>
    </div>
  </section>
  <section class="research-area" id="computational-biology">
    <div class="area-heading">
      <span class="eyebrow">Computational biology & applied ML</span><h2>
        Models that connect back to the world.
      </h2>
    </div><div class="research-prose">
      <p>
        Earlier work in fungal genomics includes FunBERT and recurrent models
        for detecting supernumerary chromosomes in fungal strains causing blast
        diseases.
      </p><p>
        I also work on explainable machine learning for transportation safety
        and anomaly detection in healthcare security. Across these problems, I
        care about useful models, interpretable results, and reliable systems.
      </p><div class="link-row">
        <a class="btn" href="/projects/funbert">FunBERT ↗</a><a
          class="btn"
          href="/projects/crash-severity">Applied machine learning ↗</a
        >
      </div>
    </div>
  </section>
  <section class="research-area publications" id="publications">
    <div class="section-heading">
      <h2>Selected publications</h2><a
        href={site.social.scholar}
        target="_blank"
        rel="noopener noreferrer">Google Scholar ↗</a
      >
    </div><ol>
      {
        publications.map((pub) => (
          <li>
            <div class="pub-content">
              <p class="periodical">
                {pub.venue} · {pub.date}
              </p>
              {pub.note && <p class="note">{pub.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
<style>
  .research-position {
    display: flex;
    gap: 32px;
    align-items: start;
    padding: 24px 0 40px;
    font-size: 13px;
  }
  .research-position .status {
    margin-top: 7px;
  }
  .research-position p {
    color: var(--text-muted);
  }
  .research-position p span {
    font-size: 12px;
    color: var(--text-faint);
  }
  .research-area {
    border-top: 1px solid var(--border);
    padding: 40px 0 48px;
    scroll-margin-top: 112px;
  }
  .area-heading {
    margin-bottom: 32px;
  }
  .area-heading h2 {
    font-size: 28px;
    margin-top: 16px;
  }
  .fundlm-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elevated);
  }
  .fundlm-feature h3 {
    font-size: 40px;
    margin: 20px 0 12px;
  }
  .fundlm-feature p {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .fundlm-feature .btn {
    margin-top: 12px;
  }
  .research-prose {
    max-width: 760px;
    color: var(--text-muted);
  }
  .research-prose p + p {
    margin-top: 16px;
  }
  @media (max-width: 760px) {
    .fundlm-feature {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .fundlm-feature {
      padding: 24px;
    }
    .area-heading h2 {
      font-size: 24px;
    }
    .research-position {
      gap: 20px;
    }
  }
</style>
