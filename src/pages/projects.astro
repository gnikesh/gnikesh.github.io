---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects" description="Selected projects by Nikesh Gyawali - machine learning, NLP, and software engineering.">
  <section class="section">
    <h2 class="section-title">Projects</h2>
    <div class="section-body">
      <p>
        A selection of my work in machine learning, natural language processing, and software engineering. Code for
        most projects is available on my{' '}
        <a href="https://github.com/gnikesh" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>

  {
    projects.map((project) => (
      <section class="section">
        <ProjectCard project={project} />
      </section>
    ))
  }
</BaseLayout>
