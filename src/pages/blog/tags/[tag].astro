---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { slugifyTag } from '../../../lib/tags';
import { site } from '../../../data/site';
import { absoluteUrl, breadcrumbSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const slugs = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      if (!slugs.has(slug)) slugs.set(slug, tag);
    }
  }
  return [...slugs.entries()].map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.tags.some((t) => slugifyTag(t) === slugifyTag(tag)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Posts tagged: ${tag}`}
  description={`Blog posts tagged with ${tag} by ${site.author.name}.`}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      mainEntityOfPage: absoluteUrl(`/blog/tags/${slugifyTag(tag)}`),
      name: `Posts tagged: ${tag}`,
      inLanguage: 'en-US',
      author: { '@id': `${site.url}/#person` },
      hasPart: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: absoluteUrl(`/blog/${post.id}`),
        datePublished: post.data.pubDate.toISOString(),
      })),
    },
    breadcrumbSchema([
      { name: 'Home', url: site.url },
      { name: 'Blog', url: absoluteUrl('/blog') },
      { name: `Tag: ${tag}`, url: absoluteUrl(`/blog/tags/${slugifyTag(tag)}`) },
    ]),
  ]}
>
  <section class="section">
    <h2 class="section-title">Posts tagged: {tag}</h2>
    <div class="section-body">
      <p><a href="/blog">&larr; All posts</a></p>
      {
        posts.length > 0 ? (
          posts.map((post) => <BlogCard post={post} />)
        ) : (
          <p>No posts found for this tag yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
