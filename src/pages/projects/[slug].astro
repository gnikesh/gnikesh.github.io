---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SequenceVisual from '../../components/SequenceVisual.astro';
import { projects } from '../../data/projects';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const relatedPosts = (await getCollection('blog')).filter(
  (post) =>
    !post.data.draft &&
    ((project.slug === 'gpu-monitor' &&
      post.id === 'gpu-monitoring-app-with-django') ||
      (project.slug === 'catan-generator' &&
        post.id === 'catan-map-generator') ||
      (project.slug === 'docker-notes' && post.id === 'docker-notes-app') ||
      (project.slug === 'gunstance' && post.id.includes('gun-control-debate'))),
);
const isFunDLM = project.slug === 'fundlm';
---

<BaseLayout title={project.name} description={project.description}>
  <a class="text-link" href="/projects">← Project archive</a>
  <header class="page-heading">
    <span class="eyebrow">{project.subtitle}</span><h1>{project.name}</h1><p>
      {project.summary}
    </p><div class="project-meta">
      <span class="status"
        >{
          project.period === 'Ongoing' ? 'ONGOING RESEARCH' : project.period
        }</span
      >
    </div>
  </header>
  {
    isFunDLM && (
      <div class="project-visual">
        <SequenceVisual />
      </div>
    )
  }
  <div class="project-content">
    <section class="section section-rule">
      <h2 class="section-title">{isFunDLM ? 'The question' : 'Overview'}</h2><p>
        {project.description}
      </p>
    </section>
    <section class="section section-rule">
      <h2 class="section-title">
        {isFunDLM ? 'Approach & current work' : 'Inside the project'}
      </h2><ul>
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </section>
    {
      isFunDLM && (
        <section class="section section-rule">
          <>
            <h2 class="section-title">Data & direction</h2>
            <p>
              The work centers on large-scale fungal genomic sequence data. The
              goal is to learn representations that are useful for downstream
              genomic analysis, connecting language-model pre-training with
              biological questions.
            </p>
            <p class="research-note">
              This is ongoing work. Results and publications will be added as
              they become available.
            </p>
            <a class="text-link" href="/projects/funbert">
              Explore the earlier FunBERT work ↗
            </a>
          </>
        </section>
      )
    }
    <div class="link-row">
      {
        project.link && (
          <a
            class="btn btn--primary"
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            {project.linkLabel ?? 'View source'} ↗
          </a>
        )
      }
      {
        isFunDLM && (
          <a class="btn btn--primary" href="/research">
            Research & publications ↗
          </a>
        )
      }
      {
        project.slug === 'catan-generator' && (
          <a
            class="btn"
            href="https://catangenerator.app/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Try the generator ↗
          </a>
        )
      }
      <a
        class="btn"
        href={`/?ask=${encodeURIComponent(`Tell me about ${project.name}`)}#nikesh-ai`}
        >Ask Nikesh AI ↗</a
      >
    </div>
    {
      relatedPosts.length > 0 && (
        <section class="section related">
          <h2 class="section-title">Notes from building it</h2>
          {relatedPosts.map((post) => (
            <a class="text-link" href={`/blog/${post.id}`}>
              {post.data.title} ↗
            </a>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>
<style>
  .page-heading {
    padding-top: 40px;
  }
  .project-meta {
    margin-top: 24px;
  }
  .project-content {
    max-width: 760px;
  }
  .project-content p,
  li {
    font-size: 16px;
    color: var(--text-muted);
  }
  .project-content li + li {
    margin-top: 14px;
  }
  ul {
    padding-left: 20px;
  }
  li::marker {
    color: var(--accent);
  }
  .project-visual {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    max-width: 760px;
    margin-bottom: 48px;
  }
  .research-note {
    margin: 20px 0;
    font-size: 14px !important;
  }
  .related {
    margin: 48px 0 0;
  }
</style>
