---
import BaseLayout from '../layouts/BaseLayout.astro';
import EducationTimeline from '../components/EducationTimeline.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import HeadFollow from '../components/HeadFollow.astro';
import { site } from '../data/site';
import { skills } from '../data/experience';
import { personSchema } from '../lib/seo';
---

<BaseLayout
  title="About"
  description="Nikesh Gyawali, computer scientist, researcher, and builder at Kansas State University."
  schema={personSchema()}
>
  <div class="about-intro">
    <header class="page-heading">
      <span class="eyebrow">A little about me</span><h1>Hi, I'm Nikesh.</h1><p>
        Computer scientist. Researcher. Builder.<br />Curious about how things
        work, and what we can make them do.
      </p>
    </header>
    <HeadFollow size={220} priority class="about-portrait" />
  </div>
  <div class="about-body">
    <section class="section section-rule">
      <h2 class="section-title">From words to genomes.</h2><div
        class="section-body"
      >
        <p>
          I'm interested in what machines can learn from sequences. During my
          Ph.D., those sequences were words: tweets, opinions, and financial
          reports. These days, they're often DNA.
        </p><p>
          I'm a Postdoctoral Fellow in the Department of Plant Pathology at
          Kansas State University, where I work on foundation language models
          for fungal genomes. It's an intersection of computer science and
          biology that keeps giving me new questions to think about.
        </p><p>
          Alongside research, I build software and write about what I'm
          learning. Sometimes that's a tool for a shared GPU cluster. Sometimes
          it's a Catan board generator that started with a weekend idea.
        </p>
      </div>
    </section>
    <section class="section section-rule">
      <span class="eyebrow">Currently</span><h2 class="current-title">
        Postdoctoral Fellow
      </h2><p class="text-muted">
        Department of Plant Pathology<br />Kansas State University, Manhattan,
        Kansas
      </p><p class="current-focus">
        <span class="status">EXPLORING</span> Foundation models for fungal genomes
      </p>
    </section>
    <section class="section section-rule"><EducationTimeline /></section>
    <section class="section section-rule">
      <h2 class="section-title">The path here</h2><p class="career-intro">
        From software and security analytics in Kathmandu to machine learning
        research in Kansas. Each stop has shaped how I approach the next
        problem.
      </p><details class="background-details">
        <summary
          >Research, teaching & industry experience <span aria-hidden="true"
            >+</span
          ></summary
        ><ExperienceTimeline showTitle={false} detailed />
      </details><details class="background-details">
        <summary>Tools I work with <span aria-hidden="true">+</span></summary
        ><div class="skill-groups">
          {
            skills.map((group) => (
              <div>
                <>
                  <h3>{group.title}</h3>
                  <div class="skill-chips">
                    {group.items.map((item) => (
                      <span class="chip">{item}</span>
                    ))}
                  </div>
                </>
              </div>
            ))
          }
        </div>
      </details>
    </section>
    <div class="link-row">
      <a
        class="btn btn--primary"
        href={site.resume}
        download="nikesh_gyawali_resume.pdf">Download CV ↗</a
      ><a
        class="btn"
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      ><a
        class="btn"
        href={site.social.scholar}
        target="_blank"
        rel="noopener noreferrer">Google Scholar ↗</a
      ><a
        class="btn"
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer">LinkedIn ↗</a
      >
    </div>
    <p class="about-contact">
      Have a question or an idea? <a href="/contact">Let's talk ↗</a>
    </p>
  </div>
</BaseLayout>
<style>
  .about-intro {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 48px;
    align-items: start;
    margin-bottom: 24px;
  }
  .about-intro :global(.about-portrait) {
    margin-top: 8px;
  }
  .about-body {
    max-width: 760px;
  }
  .section-body p {
    color: var(--text-muted);
  }
  .current-title {
    font-size: 27px;
    margin: 20px 0 12px;
  }
  .current-focus {
    margin-top: 24px;
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-muted);
  }
  .career-intro {
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .background-details {
    border-top: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    padding: 20px 0;
    font-size: 14px;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    color: var(--accent);
  }
  details[open] summary span {
    transform: rotate(45deg);
  }
  .skill-groups {
    padding: 8px 0 24px;
    display: grid;
    gap: 24px;
  }
  .skill-groups h3 {
    font-size: 14px;
    margin-bottom: 12px;
  }
  .skill-chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .about-contact {
    margin-top: 32px;
    font-size: 13px;
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .link-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .link-row .btn {
      padding: 10px 12px;
      font-size: 12px;
    }
    .about-intro {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 32px;
    }
    .about-intro :global(.about-portrait) {
      width: 140px;
      margin: 0 0 8px;
      order: -1;
    }
  }
</style>
