---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat.astro';
import SequenceVisual from '../components/SequenceVisual.astro';
import { projects } from '../data/projects';
import { personSchema } from '../lib/seo';
import { getCollection } from 'astro:content';
import { formatReadingTime } from '../utils/formatReadingTime';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const selected = ['fundlm', 'gpu-monitor', 'catan-generator'].map((slug) =>
  projects.find((project) => project.slug === slug)!,
);
const areas = [
  {
    title: 'Foundation models',
    text: 'Learning useful representations from the language of biological sequences.',
    href: '/research#foundation-models',
    symbol: '↳',
  },
  {
    title: 'Large language models',
    text: 'Understanding language, identifying stance, and building practical LLM systems.',
    href: '/research#language-models',
    symbol: '⌘',
  },
  {
    title: 'Computational biology',
    text: 'Connecting machine learning with genomics and the questions inside the data.',
    href: '/research#computational-biology',
    symbol: '⋈',
  },
];
---

<BaseLayout schema={personSchema()}>
  <section class="home-hero" aria-labelledby="home-title">
    <p class="eyebrow">
      AI <span>·</span> LLMs <span>·</span> Computational biology
    </p>
    <h1 id="home-title">Nikesh Gyawali<span>.</span></h1>
    <p class="hero-description">
      Computer scientist exploring intelligent systems,<br
        class="desktop-break"
      /> language models, and the language of life.
    </p>
    <a class="hero-position" href="/about"
      ><span class="position-dot"></span>Postdoctoral Fellow at Kansas State
      University <span aria-hidden="true">↗</span></a
    >
  </section>

  <Chat />

  <div class="workspace-note">
    <span
      >Researcher <span class="note-dot">/</span> Builder <span class="note-dot"
        >/</span
      > Always learning</span
    >
  </div>

  <section class="home-section areas-section" aria-labelledby="areas-title">
    <div class="section-heading">
      <h2 id="areas-title">What I work on</h2><span class="mono text-faint"
        >Three connected threads</span
      >
    </div>
    <div class="areas-grid">
      {
        areas.map((area) => (
          <a class="area" href={area.href}>
            <>
              <span class="area-symbol" aria-hidden="true">
                {area.symbol}
              </span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
              <span class="area-link">
                Explore <span aria-hidden="true">↗</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section" aria-labelledby="featured-title">
    <div class="section-heading">
      <h2 id="featured-title">Featured research</h2><a href="/research"
        >All research <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="featured-research">
      <div class="featured-copy">
        <span class="eyebrow">Ongoing research</span><h3>FunDLM</h3><p
          class="featured-subtitle"
        >
          Foundation models for fungal genomes.
        </p><p>
          What can a language model learn from DNA? I'm exploring how genomic
          sequences become useful representations, and how those representations
          can help us ask better biological questions.
        </p><a class="btn" href="/projects/fundlm"
          >Explore the research <span aria-hidden="true">↗</span></a
        >
      </div>
      <SequenceVisual />
    </div>
  </section>

  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">Selected projects</h2><a href="/projects"
        >The full archive <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="selected-grid">
      {
        selected.map((project) => (
          <a class="selected-project" href={`/projects/${project.slug}`}>
            <>
              <span class="mono">
                {project.slug === 'fundlm'
                  ? 'Research / Biology'
                  : project.slug === 'gpu-monitor'
                    ? 'Software / Systems'
                    : 'Experiment / Algorithms'}
              </span>
              <h3>{project.name}</h3>
              <p>{project.summary}</p>
              <span class="project-view">
                View project <span aria-hidden="true">↗</span>
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section" aria-labelledby="blog-title">
    <div class="section-heading">
      <h2 id="blog-title">From the notebook</h2><a href="/blog"
        >All writing <span aria-hidden="true">↗</span></a
      >
    </div>
    <p class="notebook-intro">
      Things I'm building, debugging, reading, and figuring out.
    </p>
    <div class="home-posts">
      {
        posts.map((post) => (
          <a class="home-post" href={`/blog/${post.id}`}>
            <>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: '2-digit',
                  year: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
              <div>
                <>
                  <h3>{post.data.title.split(':')[0]}</h3>
                  <p>{post.data.description}</p>
                  <span class="mono">
                    {post.data.tags.slice(0, 2).join(' / ')}{' '}
                    <span aria-hidden="true">·</span>{' '}
                    {formatReadingTime(post.body)}
                  </span>
                </>
              </div>
              <span class="post-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-about home-section" aria-labelledby="about-title">
    <img
      src="/images/profile/avatar.webp"
      alt="Nikesh Gyawali"
      width="120"
      height="120"
      loading="lazy"
    />
    <div>
      <span class="eyebrow">The person behind the work</span><h2
        id="about-title"
      >
        Research is a practice. Curiosity is a habit.
      </h2><p>
        I'm Nikesh, a computer scientist at Kansas State University. I work on
        AI and computational biology, build tools for the problems I run into,
        and write to make sense of what I learn.
      </p><a class="text-link" href="/about"
        >A little more about me <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
</BaseLayout>
<style>
  :global(.content) {
    padding-top: 40px;
  }
  .home-hero {
    text-align: center;
    padding: 0 0 28px;
  }
  .home-hero .eyebrow {
    font-size: 11px;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .home-hero .eyebrow span {
    padding: 0 12px;
    color: var(--text-faint);
  }
  .home-hero h1 {
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 500;
    letter-spacing: -0.065em;
    margin-bottom: 16px;
    line-height: 1.1;
  }
  .home-hero h1 > span {
    color: var(--accent);
  }
  .hero-description {
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .hero-position {
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-faint);
    margin-top: 8px;
    min-height: 32px;
  }
  .position-dot {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }
  .workspace-note {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin: 16px 0 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .note-dot {
    padding: 0 8px;
    color: var(--border);
  }
  .home-section {
    padding: 40px 0 48px;
    border-top: 1px solid var(--border);
  }
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .area {
    color: var(--text);
  }
  .area-symbol {
    color: var(--accent);
    font-size: 25px;
    display: block;
    margin-bottom: 18px;
  }
  .area h3 {
    font-size: 17px;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  .area p {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 270px;
  }
  .area-link {
    display: block;
    font-size: 11px;
    color: var(--accent);
    margin-top: 20px;
  }
  .featured-research {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 48px;
    padding: 32px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    border-radius: 8px;
    align-items: center;
  }
  .featured-copy h3 {
    font-size: 44px;
    letter-spacing: -0.05em;
    font-weight: 500;
    margin: 16px 0 8px;
  }
  .featured-subtitle {
    font-size: 16px;
    margin-bottom: 16px;
  }
  .featured-copy p + p {
    font-size: 13px;
    color: var(--text-muted);
  }
  .featured-copy .btn {
    margin-top: 24px;
  }
  .selected-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .selected-project {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--bg-elevated);
  }
  .selected-project:hover {
    border-color: var(--accent);
  }
  .selected-project .mono {
    font-size: 11px;
    color: var(--text-faint);
  }
  .selected-project h3 {
    font-size: 21px;
    margin: 28px 0 12px;
  }
  .selected-project p {
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 32px;
  }
  .project-view {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-size: 11px;
    color: var(--accent);
  }
  .notebook-intro {
    font-size: 13px;
    color: var(--text-muted);
    margin: -12px 0 24px;
  }
  .home-post {
    display: grid;
    grid-template-columns: 130px 1fr 24px;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    color: var(--text);
  }
  .home-post time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
    padding-top: 4px;
  }
  .home-post h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .home-post p {
    font-size: 13px;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .home-post .mono {
    font-size: 11px;
    color: var(--text-faint);
  }
  .post-arrow {
    color: var(--accent);
    font-size: 20px;
  }
  .home-about {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    align-items: center;
    padding-bottom: 0;
  }
  .home-about img {
    border-radius: 8px;
    width: 120px;
    height: 120px;
    object-fit: cover;
  }
  .home-about h2 {
    font-size: 25px;
    margin: 14px 0;
  }
  .home-about p {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 660px;
    margin-bottom: 20px;
  }
  @media (max-width: 760px) {
    .featured-research {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .selected-grid {
      grid-template-columns: 1fr;
    }
    .selected-project h3 {
      margin-top: 16px;
    }
    .selected-project p {
      margin-bottom: 20px;
    }
  }
  @media (max-width: 640px) {
    :global(.content) {
      padding-top: 32px;
    }
    .home-hero {
      padding-top: 16px;
      padding-bottom: 32px;
    }
    .home-hero .eyebrow {
      font-size: 10px;
      letter-spacing: 0.03em;
    }
    .home-hero .eyebrow span {
      padding: 0 4px;
    }
    .home-hero h1 {
      font-size: clamp(38px, 10vw, 60px);
    }
    .hero-description {
      font-size: 14px;
    }
    .desktop-break {
      display: none;
    }
    .hero-position {
      font-size: 11px;
    }
    .workspace-note {
      gap: 12px;
      margin-bottom: 40px;
    }
    .workspace-note > span:last-child {
      font-size: 11px;
    }
    .home-section {
      padding: 32px 0;
    }
    .areas-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .area {
      display: grid;
      grid-template-columns: 32px 1fr;
      column-gap: 12px;
    }
    .area-symbol {
      grid-row: span 3;
      margin: 0;
    }
    .area p {
      max-width: none;
    }
    .area-link {
      grid-column: 2;
      margin-top: 12px;
    }
    .area p,
    .selected-project p,
    .home-post p {
      font-size: 15px;
    }
    .area-link,
    .project-view {
      font-size: 12px;
    }
    .home-post time,
    .home-post .mono {
      font-size: 12px;
    }
    .featured-research {
      padding: 24px;
    }
    .home-post {
      grid-template-columns: 1fr 20px;
      gap: 12px;
    }
    .home-post time {
      grid-column: 1 / -1;
    }
    .home-about {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-bottom: 0;
    }
    .home-about img {
      width: 80px;
      height: 80px;
    }
  }
</style>
