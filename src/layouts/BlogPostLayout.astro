---
import '../styles/markdown.css';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../utils/formatDate';
import { formatReadingTime } from '../utils/formatReadingTime';
import { site } from '../data/site';
import { absoluteUrl, breadcrumbSchema, type Schema } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const updatedDate = post.data.updatedDate ?? pubDate;
const readingTime = formatReadingTime(post.body);
const canonicalUrl = absoluteUrl(`/blog/${post.id}`);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;

const postSchema: Schema[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: canonicalUrl,
    headline: title,
    name: title,
    description,
    image: absoluteUrl(post.data.cover ?? site.ogImage),
    datePublished: pubDate.toISOString(),
    dateModified: updatedDate.toISOString(),
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#person` },
    articleSection: 'Blog',
    inLanguage: 'en-US',
    keywords: tags.join(', '),
    wordCount,
    isAccessibleForFree: true,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.post__title', '.post__meta', '.prose p'],
    },
  },
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: absoluteUrl('/blog') },
    { name: title, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  schema={postSchema}
  ogType="article"
  articleMeta={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate.toISOString(),
    authorUrl: site.url,
    section: 'Blog',
    tags,
  }}
>
  <article class="post">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime}</span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Updated {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>
      <div class="post__tags">
        <TagList tags={tags} accent />
      </div>
    </header>

    {
      post.data.cover && (
        <figure class="post__cover">
          <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" />
        </figure>
      )
    }

    <div class="post__body">
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="post__footer">
      <a href="/blog">&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post__header {
    margin-bottom: 2rem;
  }

  .post__title {
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-faint);
    font-family: var(--font-mono);
    margin-bottom: 14px;
  }

  .post__tags {
    margin-bottom: 6px;
  }

  .post__cover {
    margin: 0 0 2rem;
  }

  .post__cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .post__body {
    font-size: 16px;
  }

  .post__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--text-muted);
  }

  .post__footer a {
    color: var(--accent);
  }
</style>
