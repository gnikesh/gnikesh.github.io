---
import '../styles/markdown.css';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../utils/formatDate';
import { formatReadingTime } from '../utils/formatReadingTime';
import { site } from '../data/site';
import { absoluteUrl, breadcrumbSchema, type Schema } from '../lib/seo';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const updatedDate = post.data.updatedDate ?? pubDate;
const readingTime = formatReadingTime(post.body);
const canonicalUrl = absoluteUrl(`/blog/${post.id}`);
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const orderedPosts = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const position = orderedPosts.findIndex((entry) => entry.id === post.id);
const newer = orderedPosts[position - 1];
const older = orderedPosts[position + 1];
const coverInBody =
  post.data.cover && (post.body ?? '').includes(`](${post.data.cover})`);

const postSchema: Schema[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: canonicalUrl,
    headline: title,
    name: title,
    description,
    image: absoluteUrl(post.data.cover ?? site.ogImage),
    datePublished: pubDate.toISOString(),
    dateModified: updatedDate.toISOString(),
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#person` },
    articleSection: 'Blog',
    inLanguage: 'en-US',
    keywords: tags.join(', '),
    wordCount,
    isAccessibleForFree: true,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.post__title', '.post__meta', '.prose p'],
    },
  },
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Blog', url: absoluteUrl('/blog') },
    { name: title, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  schema={postSchema}
  ogType="article"
  articleMeta={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate.toISOString(),
    authorUrl: site.url,
    section: 'Blog',
    tags,
  }}
>
  <article class="post">
    <header class="post__header">
      <a class="post__breadcrumb" href="/blog">← Notebook</a>
      <h1 class="post__title">{title}</h1>
      <div class="post__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingTime}</span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>Updated {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
      </div>
      <div class="post__tags">
        <TagList tags={tags} accent />
      </div>
      <p class="post__description">{description}</p>
      <a
        class="post__ask"
        href={`/?ask=${encodeURIComponent(`Tell me about the article "${title}"`)}#nikesh-ai`}
        >Ask Nikesh AI about this article <span aria-hidden="true">↗</span></a
      >
    </header>

    {
      post.data.cover && !coverInBody && (
        <figure class="post__cover">
          <img
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            loading="lazy"
          />
        </figure>
      )
    }

    <div class="post__body">
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="post__footer">
      <div class="post__neighbors">
        <div>
          {
            older && (
              <a href={`/blog/${older.id}`}>
                <>
                  <span>← Previous note</span>
                  <strong>{older.data.title}</strong>
                </>
              </a>
            )
          }
        </div>
        <div>
          {
            newer && (
              <a href={`/blog/${newer.id}`}>
                <>
                  <span>Next note →</span>
                  <strong>{newer.data.title}</strong>
                </>
              </a>
            )
          }
        </div>
      </div>
      <a class="post__back" href="/blog">&larr; Back to the notebook</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 640px;
    margin: 0 auto;
  }
  .post__header {
    margin-bottom: 2rem;
  }

  .post__title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    margin-top: 28px;
    line-height: 1.2;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-faint);
    font-family: var(--font-mono);
    margin-bottom: 14px;
  }

  .post__tags {
    margin-bottom: 6px;
  }

  .post__cover {
    margin: 0 0 2rem;
  }

  .post__cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .post__body {
    font-size: 17px;
  }

  .post__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 14px;
    color: var(--text-muted);
  }

  .post__footer a {
    color: var(--accent);
  }
  .post__breadcrumb {
    color: var(--text-faint);
    font-size: 12px;
  }
  .post__description {
    color: var(--text-muted);
    font-size: 19px;
    line-height: 1.55;
    margin: 24px 0;
  }
  .post__ask {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 13px;
    color: var(--accent);
    border-bottom: 1px solid var(--border);
  }
  .post__neighbors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }
  .post__neighbors a {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .post__neighbors span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .post__neighbors strong {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: 17px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
    text-wrap: balance;
  }
  .post__neighbors > div:last-child {
    text-align: right;
  }
  .post__back {
    font-size: 12px;
  }
  @media (max-width: 480px) {
    .post__neighbors {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .post__neighbors > div:last-child {
      text-align: left;
    }
  }
</style>
