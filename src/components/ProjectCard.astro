---
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="archive-project">
  <span class="project-period mono">{project.period}</span>
  <div>
    <span class="project-sub mono">{project.subtitle}</span><h2>
      <a href={`/projects/${project.slug}`}>{project.name}</a>
    </h2><p>{project.summary}</p>
  </div>
  <a
    class="project-open"
    href={`/projects/${project.slug}`}
    aria-label={`Explore ${project.name}`}><span aria-hidden="true">↗</span></a
  >
</article>
<style>
  .archive-project {
    display: grid;
    grid-template-columns: 150px 1fr 44px;
    align-items: start;
    gap: 24px;
    border-top: 1px solid var(--border);
    padding: 32px 0;
  }
  .project-period,
  .project-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project-period {
    color: var(--text-faint);
  }
  .project-sub {
    color: var(--accent);
  }
  h2 {
    margin: 12px 0;
    font-size: 27px;
  }
  h2 a {
    color: var(--text);
  }
  h2 a:hover {
    color: var(--accent);
  }
  p {
    color: var(--text-muted);
    font-size: 14px;
  }
  .project-open {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-muted);
  }
  .project-open:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 640px) {
    .archive-project {
      grid-template-columns: 1fr 44px;
      gap: 12px;
    }
    .project-period {
      grid-column: 1 / -1;
    }
    h2 {
      font-size: 24px;
    }
  }
</style>
