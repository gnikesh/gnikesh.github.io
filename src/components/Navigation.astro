---
import { navigation } from '../data/navigation';
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="nav" aria-label="Primary">
  <ul class="nav-list" id="primary-navigation">
    {
      navigation.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'nav-link',
              { 'nav-link--active': isActive(item.href) },
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    padding: 0;
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
  }
  .nav-link:hover,
  .nav-link--active {
    color: var(--accent);
  }
  .nav-link--active {
    text-decoration: underline;
    text-underline-offset: 8px;
  }
  @media (max-width: 760px) {
    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 16px 20px 24px;
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
    }
    .nav-list--open {
      display: flex;
    }
    .nav-link {
      min-height: 48px;
      font-size: 15px;
    }
    :global(html:not(.js)) .nav-list {
      display: flex;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      padding: 0;
      gap: 10px;
      border: 0;
    }
    :global(html:not(.js)) .nav-link {
      font-size: 11px;
    }
  }
</style>
<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const list = document.querySelector<HTMLElement>('.nav-list');
  if (menuButton && list) {
    const setOpen = (open: boolean) => {
      list.classList.toggle('nav-list--open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuButton.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) list.querySelector<HTMLAnchorElement>('a')?.focus();
    });
    document.addEventListener('click', (event) => {
      if (
        !menuButton.contains(event.target as Node) &&
        !list.contains(event.target as Node)
      )
        setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        menuButton.getAttribute('aria-expanded') === 'true'
      ) {
        setOpen(false);
        menuButton.focus();
      }
    });
    window
      .matchMedia('(min-width: 761px)')
      .addEventListener('change', () => setOpen(false));
  }
</script>
