---
import Navigation from './Navigation.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
---

<header class="header">
  <div class="header__inner">
    <a class="wordmark" href="/" aria-label="GNIKESH home"
      >GNIKESH<span aria-hidden="true">.</span></a
    >
    <div class="header__right">
      <Navigation currentPath={Astro.url.pathname} />
      <a
        class="github-link"
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a
      >
      <ThemeToggle />
      <button
        class="menu-button"
        data-menu-button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
        >
      </button>
    </div>
  </div>
</header>
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    padding: 0 32px;
    margin: 0 auto;
    max-width: var(--wrapper-max);
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 21px;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--text);
  }
  .wordmark span {
    color: var(--accent);
  }
  .header__right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .github-link {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 500;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .github-link:hover {
    color: var(--accent);
  }
  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elevated);
    color: var(--text);
  }
  @media (max-width: 760px) {
    .header__right {
      gap: 12px;
    }
    .github-link {
      display: none;
    }
    .menu-button {
      display: flex;
    }
    /* Pair the theme toggle with the menu button beside it. */
    .header__right :global(.theme-toggle) {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg-elevated);
    }
  }
  @media (max-width: 640px) {
    .header__inner {
      height: 68px;
      padding: 0 20px;
    }
  }
</style>
