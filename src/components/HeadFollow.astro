---
import { headFollow } from '../data/head-follow';
import { site } from '../data/site';

interface Props {
  /** Rendered width in CSS pixels; height follows the frame aspect ratio. */
  size: number;
  priority?: boolean;
  class?: string;
}

const { size, priority = false, class: className } = Astro.props;
const { still, sheet } = headFollow;
const height = Math.round((size * sheet.frameHeight) / sheet.frameWidth);
---

<div
  class:list={['head-follow', className]}
  style={`--head-width: ${size}px; aspect-ratio: ${sheet.frameWidth} / ${sheet.frameHeight};`}
  data-head-follow
  data-sheet={JSON.stringify(sheet)}
>
  <img
    src={still}
    alt={site.author.name}
    width={size}
    height={height}
    decoding="async"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  import { initializeHeadFollow } from '../lib/head-follow';
  document
    .querySelectorAll<HTMLElement>('[data-head-follow]')
    .forEach(initializeHeadFollow);
</script>

<style>
  .head-follow {
    position: relative;
    isolation: isolate;
    width: var(--head-width);
    max-width: 100%;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Dark hair and suit disappear into the dark page without a faint halo behind them. */
  :global([data-theme='dark']) .head-follow::before {
    content: '';
    position: absolute;
    /* Stays within the portrait's width so it never widens the page next to a viewport edge. */
    inset: -10% 0 14%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 12%, transparent),
      color-mix(in srgb, var(--accent) 5%, transparent) 55%,
      transparent
    );
    pointer-events: none;
  }
  .head-follow img,
  .head-follow canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .head-follow canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .head-follow[data-ready] canvas {
    opacity: 1;
  }
  .head-follow[data-ready] img {
    visibility: hidden;
  }
</style>
