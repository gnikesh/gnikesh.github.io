# Private server-side key. Never use a PUBLIC_ prefix for credentials.
OPENROUTER_API_KEY=
# Optional model override. The default supports strict JSON schema outputs.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optional production chat backend URL. Local Astro development uses /api/chat.
# This URL is public. GitHub Pages cannot execute the private backend itself.
PUBLIC_CHAT_ENDPOINT=
# Optional settings for npm run chat:serve.
CHAT_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322,https://gnikesh.github.io,https://gnikesh.com
CHAT_HOST=127.0.0.1
# Optional exact proxy IPs that append verified X-Forwarded-For addresses.
CHAT_TRUSTED_PROXY_IPS=
PORT=8787
